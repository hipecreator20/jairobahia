rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User validation helper
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'isOwner', 'preferences', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('isOwner' in data) || data.isOwner is bool) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 2. Project validation helper
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'description', 'sceneCount', 'thumbnail', 'status', 'tags', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('sceneCount' in data) || data.sceneCount is number) &&
             (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 1024)) &&
             (!('status' in data) || (data.status in ['active', 'archived', 'completed'])) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 3. Character validation helper
    function isValidCharacter(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'name', 'niche', 'bio', 'visualDna', 'avatarUrl', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             (!('niche' in data) || (data.niche is string && data.niche.size() <= 64)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('visualDna' in data) || (data.visualDna is string && data.visualDna.size() <= 2000)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 4. Story validation helper
    function isValidStory(data) {
      return data.keys().hasAll(['id', 'title', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'synopsis', 'characterIds', 'sceneCount', 'status', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             (!('synopsis' in data) || (data.synopsis is string && data.synopsis.size() <= 2000)) &&
             (!('characterIds' in data) || (data.characterIds is list && data.characterIds.size() <= 50)) &&
             (!('sceneCount' in data) || data.sceneCount is number) &&
             (!('status' in data) || (data.status in ['draft', 'in_progress', 'completed'])) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 5. Scene validation helper
    function isValidScene(data) {
      return data.keys().hasAll(['id', 'storyId', 'title', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'storyId', 'title', 'prompt', 'visualStyle', 'status', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.storyId is string && data.storyId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             data.ownerId == request.auth.uid &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2000)) &&
             (!('visualStyle' in data) || (data.visualStyle is string && data.visualStyle.size() <= 128)) &&
             (!('status' in data) || (data.status in ['draft', 'ready', 'rendered'])) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 6. ImageAsset validation helper
    function isValidImageAsset(data) {
      return data.keys().hasAll(['id', 'imageUrl', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'projectId', 'characterId', 'prompt', 'imageUrl', 'storagePath', 'aspect', 'modelUsed', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.imageUrl is string && data.imageUrl.size() <= 2048 &&
             data.ownerId == request.auth.uid &&
             (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128)) &&
             (!('characterId' in data) || (data.characterId is string && data.characterId.size() <= 128)) &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2000)) &&
             (!('aspect' in data) || (data.aspect is string && data.aspect.size() <= 20)) &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 7. PromptVersion validation helper
    function isValidPromptVersion(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'platform', 'content', 'tags', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             data.content is string && data.content.size() <= 4000 &&
             data.ownerId == request.auth.uid &&
             (!('platform' in data) || (data.platform is string && data.platform.size() <= 64)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 8. GenerationJob validation helper
    function isValidGenerationJob(data) {
      return data.keys().hasAll(['id', 'type', 'status', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'type', 'status', 'prompt', 'resultUrl', 'error', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type is string && data.type.size() <= 64 &&
             data.status in ['queued', 'processing', 'completed', 'failed'] &&
             data.ownerId == request.auth.uid &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2000)) &&
             (!('resultUrl' in data) || (data.resultUrl is string && data.resultUrl.size() <= 1024)) &&
             (!('error' in data) || (data.error is string && data.error.size() <= 500)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing is forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && incoming().id == projectId;
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }

    // Characters collection
    match /characters/{characterId} {
      allow get: if isSignedIn() && isValidId(characterId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(characterId) && isValidCharacter(incoming()) && incoming().id == characterId;
      allow update: if isSignedIn() && isValidId(characterId) && isValidCharacter(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(characterId) && existing().ownerId == request.auth.uid;
    }

    // Stories collection
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(storyId) && isValidStory(incoming()) && incoming().id == storyId;
      allow update: if isSignedIn() && isValidId(storyId) && isValidStory(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(storyId) && existing().ownerId == request.auth.uid;
    }

    // Scenes collection
    match /scenes/{sceneId} {
      allow get: if isSignedIn() && isValidId(sceneId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sceneId) && isValidScene(incoming()) && incoming().id == sceneId;
      allow update: if isSignedIn() && isValidId(sceneId) && isValidScene(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(sceneId) && existing().ownerId == request.auth.uid;
    }

    // ImageAssets collection
    match /imageAssets/{assetId} {
      allow get: if isSignedIn() && isValidId(assetId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(assetId) && isValidImageAsset(incoming()) && incoming().id == assetId;
      allow update: if isSignedIn() && isValidId(assetId) && isValidImageAsset(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(assetId) && existing().ownerId == request.auth.uid;
    }

    // PromptVersions collection
    match /promptVersions/{promptId} {
      allow get: if isSignedIn() && isValidId(promptId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(promptId) && isValidPromptVersion(incoming()) && incoming().id == promptId;
      allow update: if isSignedIn() && isValidId(promptId) && isValidPromptVersion(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(promptId) && existing().ownerId == request.auth.uid;
    }

    // GenerationJobs collection
    match /generationJobs/{jobId} {
      allow get: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(jobId) && isValidGenerationJob(incoming()) && incoming().id == jobId;
      allow update: if isSignedIn() && isValidId(jobId) && isValidGenerationJob(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
    }
  }
}
