rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/images/{filename} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'indicabrasiloficiall@gmail.com';
      }
      allow read, delete: if owner();
      allow create, update: if owner() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
