rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/images/{filename} {
      function approved() {
        return request.auth != null && request.auth.token.email_verified == true
          && (request.auth.uid == 'FTqparyG04fCf9eDgUTa6e2tWgp2'
            || request.auth.token.approved == true);
      }
      allow read, delete: if approved() && request.auth.uid == uid;
      allow create, update: if approved() && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
