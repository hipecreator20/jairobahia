{
  "buildCommand": "npm run lint && npm test && npm run build",
  "outputDirectory": "dist",
  "crons": [{"path":"/api/maintenance/expired-media","schedule":"0 3 * * *"}],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": null,
  "installCommand": "npm ci"
}
